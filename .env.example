LARK_CLI_BIN=lark-cli
LARK_IDENTITY=bot
LARK_EVENT_KEY=im.message.receive_v1
BOT_NAME=
GROUP_REQUIRE_MENTION=true

GROUP_SESSIONS_PER_USER=true
ALLOWED_USER_IDS=
GROUP_POLICY=open
GROUP_RULES=

TEXT_BATCH_DELAY_MS=600
TEXT_BATCH_MAX_MESSAGES=8
TEXT_BATCH_MAX_CHARS=4000

# 路径类配置请一律使用绝对路径，避免因启动目录不同产生第二份数据
STATE_FILE=/root/codearts-feishu-bridge/data/sessions.json
DEDUP_FILE=/root/codearts-feishu-bridge/data/seen.json
MEDIA_DIR=/root/codearts-feishu-bridge/data/media
MEDIA_RETENTION_DAYS=7

BRIDGE_MEDIA=true
TEXT_INJECT_MAX_BYTES=102400
TEXT_INJECT_MAX_CHARS=8000

# P3-lite 持久化任务队列（实现后生效）
TASK_DB=/root/codearts-feishu-bridge/data/tasks.db
TASK_AUTO_RETRY=true
TASK_MAX_ATTEMPTS=2
TASK_RETENTION_DAYS=30

BRIDGE_REACTIONS=true
REACTION_PROCESSING=Typing
REACTION_FAILURE=CrossMark
BRIDGE_PROGRESS_CARD=true
BRIDGE_COMPLETION_NOTICE=true

DEDUP_TTL_MS=86400000
DEDUP_MAX=2048

CODEARTS_BIN=codearts
CODEARTS_WORKDIR=/root/your-project
CODEARTS_MODEL=
CODEARTS_AGENT=
CODEARTS_APPROVAL_MODE=auto
CODEARTS_TIMEOUT_MS=600000
CODEARTS_MAX_CONCURRENCY=2

ALLOWED_CHAT_IDS=
REPLY_FORMAT=card
REPLY_CHUNK_SIZE=1800
REPLY_MAX_CHUNKS=4
BRIDGE_ACK=true
LOG_LEVEL=info