LARK_CLI_BIN=lark-cli
LARK_IDENTITY=bot
LARK_EVENT_KEY=im.message.receive_v1
BOT_NAME=
GROUP_REQUIRE_MENTION=true

GROUP_SESSIONS_PER_USER=true
ALLOWED_USER_IDS=
GROUP_POLICY=open
GROUP_RULES=

TEXT_BATCH_DELAY_MS=600
TEXT_BATCH_MAX_MESSAGES=8
TEXT_BATCH_MAX_CHARS=4000

BRIDGE_REACTIONS=true
REACTION_PROCESSING=Typing
REACTION_FAILURE=CrossMark
BRIDGE_PROGRESS_CARD=true

DEDUP_FILE=./data/seen.json
DEDUP_TTL_MS=86400000
DEDUP_MAX=2048

CODEARTS_BIN=codearts
CODEARTS_WORKDIR=/root/your-project
CODEARTS_MODEL=
CODEARTS_AGENT=
CODEARTS_APPROVAL_MODE=auto
CODEARTS_TIMEOUT_MS=600000
CODEARTS_MAX_CONCURRENCY=2

ALLOWED_CHAT_IDS=
STATE_FILE=./data/sessions.json
REPLY_FORMAT=card
REPLY_CHUNK_SIZE=1800
REPLY_MAX_CHUNKS=4
BRIDGE_ACK=true
LOG_LEVEL=info