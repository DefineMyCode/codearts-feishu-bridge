LARK_CLI_BIN=lark-cli
LARK_IDENTITY=bot
LARK_EVENT_KEY=im.message.receive_v1
BOT_NAME=
GROUP_REQUIRE_MENTION=true

CODEARTS_BIN=codearts
CODEARTS_WORKDIR=/root/your-project
CODEARTS_MODEL=
CODEARTS_AGENT=
CODEARTS_APPROVAL_MODE=auto
CODEARTS_TIMEOUT_MS=600000
CODEARTS_MAX_CONCURRENCY=2

ALLOWED_CHAT_IDS=
STATE_FILE=./data/sessions.json
REPLY_FORMAT=card
REPLY_CHUNK_SIZE=1800
REPLY_MAX_CHUNKS=4
BRIDGE_ACK=true
LOG_LEVEL=info